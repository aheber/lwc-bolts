{
  "name": "@lwc-bolts/monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Lightning Bolts is an enrichment package for Lightning Web Components (LWC)",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "lwc",
    "lightning-web-components"
  ],
  "workspaces": [
    "packages/lightning-base-components",
    "packages/sf2ts",
    "packages/sfdx-project",
    "packages/project-setup",
    "packages/sf-plugin",
    "packages/typescript-content-mapper",
    "packages/vscode-extension"
  ],
  "author": {
    "name": "Anthony Heber",
    "email": "anthony@heber.dev",
    "url": "https://github.com/aheber"
  },
  "license": "MIT",
  "devDependencies": {
    "@vscode/vsce": "^4.1.0",
    "ovsx": "^0.10.1",
    "prettier": "3.6.2"
  },
  "overrides": {
    "jws": "^4.0.1"
  },
  "allowScripts": {
    "@vscode/vsce-sign": true
  }
}
