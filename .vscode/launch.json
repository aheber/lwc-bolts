{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // See: https://github.com/microsoft/TypeScript/wiki/Debugging-Language-Service-in-VS-Code
      "type": "node",
      "request": "attach",
      "name": "Attach to VS Code TS Server via Port",
      "processId": "${command:PickProcess}"
    },
    {
      // Builds the extension and the content mapper, then opens a new window running this extension.
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension"],
      "outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "Build the extension and the content mapper"
    },
    {
      // Builds the extension and the content mapper, then opens the test fixture you pick in a window
      // running this extension. The picker's options are the folders in tests/fixtures (a test in
      // the extension checks they match).
      "name": "Run Extension on a test fixture",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "${workspaceFolder}/tests/fixtures/${input:testFixture}"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "Build the extension and the content mapper"
    }
  ],
  "inputs": [
    {
      "id": "testFixture",
      "type": "pickString",
      "description": "The test fixture to open with the extension",
      "options": ["example-project", "decomposed-labels", "managed-packages"],
      "default": "example-project"
    }
  ]
}
