exports[`Convert:ApexClass > SObject definitions > exposes fields without @AuraEnabled and documents them from block comments 1`] = `
declare namespace Apex {
  interface Account {
    AccountNumber?: string;
    Contacts?: Apex.Contact[];
    CreatedBy?: Apex.User;
    CreatedDate?: string;
    /**
     * The account's annual revenue,
     * in the org's currency.
     */
    AnnualRevenue?: number;
    Owner?: Record<string, unknown>;
    Records?: unknown;
  }
}

`;

