exports[`Convert:ApexClass > Carries ApexDoc comments to classes, fields, methods and parameters 1`] = `
declare namespace Apex {
  /**
   * Account helpers.
   *
   * @author Someone
   */
  interface Accounts {
    /**
     * The record name
     */
    name?: string;
    /**
     * Internal counter
     *
     * @deprecated not exposed; property must be @AuraEnabled, public or global
     */
    count?: number;
  }
  namespace Accounts {
    /**
     * Inner doc
     */
    interface Inner {}
  }
}
declare module "@salesforce/apex/Accounts.load" {
  /**
   * ---
   * **Apex**
   *
   * \`\`\`apex
   * Accounts load(Id recordId, Integer depth)
   * \`\`\`
   *
   * Loads an account by its Id.
   *
   * @param recordId the record
   *   to load
   * @param DEPTH how many levels deep
   * @returns the account
   * @example
   *   load({ recordId: '001' });
   */
  const load: {
    (param: { /** the record to load */ recordId: string; /** how many levels deep */ depth: number }): Promise<Apex.Accounts>;
    adapter: import("lwc").WireAdapterConstructor<
      { /** the record to load */ recordId: string; /** how many levels deep */ depth: number },
      { error?: unknown; data?: Apex.Accounts; }
    >;
  };
  export default load;
}
declare module "@salesforce/apex/Accounts.other" {
  /**
   * ---
   * **Apex**
   *
   * \`\`\`apex
   * void other()
   * \`\`\`
   *
   * Documented after the annotation
   */
  const other: {
    (): Promise<void>;
  };
  export default other;
}
declare module "@salesforce/apex/Accounts.plain" {
  /**
   * ---
   * **Apex**
   *
   * \`\`\`apex
   * void plain()
   * \`\`\`
   */
  const plain: {
    (): Promise<void>;
  };
  export default plain;
}

`;

exports[`Convert:ApexClass > Class Properties 1`] = `
declare namespace Apex {
  interface TestClass1 {
    prop1?: string;
    prop2?: number;
    /** @deprecated not exposed; property must be @AuraEnabled, public or global */
    prop3?: number;
    /** @deprecated not exposed; property must be @AuraEnabled, public or global */
    prop4?: string;
    /** @deprecated not exposed; property must be non-static */
    prop5?: string;
    /** @deprecated not exposed; property must be @AuraEnabled */
    prop6?: string;
  }
}
declare module "@salesforce/apex/TestClass1.method1" {
  /**
   * ---
   * **Apex**
   *
   * \`\`\`apex
   * List<String> method1(String blarg, String yip)
   * \`\`\`
   */
  const method1: {
    (param: { blarg: string; yip: string }): Promise<string[]>;
  };
  export default method1;
}
declare module "@salesforce/apex/TestClass1.method2" {
  /**
   * ---
   * **Apex**
   *
   * \`\`\`apex
   * List<String> method2(String blarg, String yip)
   * \`\`\`
   */
  const method2: {
    (param: { blarg: string; yip: string }): Promise<string[]>;
    adapter: import("lwc").WireAdapterConstructor<
      { blarg: string; yip: string },
      { error?: unknown; data?: string[]; }
    >;
  };
  export default method2;
}

`;

exports[`Convert:ApexClass > Continuation 1`] = `
