    (param: { labels: string[]; state: unknown }): Promise<unknown>;
    adapter: import("lwc").WireAdapterConstructor<
      { labels: string[]; state: unknown },
      { error?: unknown; data?: unknown; }
    >;
  };
  export default processResponse;
}

`;

exports[`Convert:ApexClass > Declares Apex types globally when the namespace is null 1`] = `
interface Outer {
  child?: Outer.Inner;
}
declare namespace Outer {
  interface Inner {
    name?: string;
  }
}
declare module "@salesforce/apex/Outer.get" {
  /**
   * ---
   * **Apex**
   *
   * \`\`\`apex
   * Outer.Inner get(Outer o)
   * \`\`\`
   */
  const get: {
    (param: { o: Outer }): Promise<Outer.Inner>;
  };
  export default get;
}

`;

exports[`Convert:ApexClass > Declares Apex types in a custom (dotted) namespace 1`] = `
declare namespace Acme.Apex {
  interface Outer {
    child?: Acme.Apex.Outer.Inner;
  }
  namespace Outer {
    interface Inner {
      name?: string;
    }
  }
}
declare module "@salesforce/apex/Outer.get" {
  /**
   * ---
   * **Apex**
   *
   * \`\`\`apex
   * Outer.Inner get(Outer o)
   * \`\`\`
   */
  const get: {
    (param: { o: Acme.Apex.Outer }): Promise<Acme.Apex.Outer.Inner>;
  };
  export default get;
}

`;

exports[`Convert:ApexClass > Inner Class 1`] = `
declare namespace Apex {
  interface TestClass1 {
    prop1?: string;
    /** @deprecated not exposed; property must be non-static */
    prop4?: string;
  }
  namespace TestClass1 {
    interface TestClass2 {
      prop2?: number;
      /** @deprecated not exposed; property must be @AuraEnabled, public or global */
      prop3?: number;
    }
  }
}
declare module "@salesforce/apex/TestClass1.method1" {
  /**
   * ---
   * **Apex**
   *
   * \`\`\`apex
   * List<TestClass1.TestClass2> method1(TestClass1 blarg, TestClass1.TestClass2 yip)
   * \`\`\`
   */
  const method1: {
    (param: { blarg: Apex.TestClass1; yip: Apex.TestClass1.TestClass2 }): Promise<Apex.TestClass1.TestClass2[]>;
    adapter: import("lwc").WireAdapterConstructor<
      { blarg: Apex.TestClass1; yip: Apex.TestClass1.TestClass2 },
      { error?: unknown; data?: Apex.TestClass1.TestClass2[]; }
    >;
  };
  export default method1;
}

`;

