    adapter: import("lwc").WireAdapterConstructor<
      never,
      { error?: unknown; data?: unknown; }
    >;
  };
  export default startRequest;
}
declare module "@salesforce/apex/SampleContinuationClass.processResponse" {
  /**
   * ---
   * **Apex**
   *
   * \`\`\`apex
