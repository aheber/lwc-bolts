{
  "name": "@lwc-bolts/sf2ts",
  "version": "1.0.0",
  "private": false,
  "description": "Converts Salesforce metadata to LWC compatible TypeScript",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Anthony Heber",
    "email": "anthony@heber.dev",
    "url": "https://github.com/aheber"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@lwc-bolts/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "generate:apex-library": "node scripts/generate-apex-library.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@lwc-bolts/source --test 'test/**/*.test.ts'",
    "test:update": "node --conditions=@lwc-bolts/source --test --test-update-snapshots 'test/**/*.test.ts'",
    "test:coverage": "node --conditions=@lwc-bolts/source --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/apex/library.generated.ts' 'test/**/*.test.ts'"
  },
  "keywords": [
    "salesforce",
    "apex",
    "lwc",
    "typescript"
  ],
  "dependencies": {
    "@lwc-bolts/lightning-base-components": "^1.0.0",
    "@lwc/template-compiler": "~9.4.3",
    "@sveltejs/acorn-typescript": "^1.0.13",
    "acorn": "^8.19.0",
    "htmlparser2": "^10.1.0",
    "web-tree-sitter-sfapex": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.1.0-beta"
  }
}
